#!/usr/bin/env bash
# Run the CLI with the project's own interpreter, wherever the checkout sits.
# A hard-coded shebang points at whatever Python the last machine had; the
# venv beside this script is the one that actually has Pillow and exifread.
set -e
here="$(cd "$(dirname "$0")" && pwd)"

if [ -x "$here/.venv/bin/python" ]; then
    exec "$here/.venv/bin/python" -m photo_import.cli "$@"
fi

exec uv run --project "$here" photo-import "$@"
